# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Encrypts camera passwords. Never change it once cameras exist (back it up!).
FIELD_ENCRYPTION_KEY=
SERVICE_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_USER=surveillance
POSTGRES_DB=surveillance

DJANGO_ALLOWED_HOSTS=localhost,surveillance.example.com
DJANGO_DEBUG=0
# 1 = cookies only over HTTPS (browsers also accept them on http://localhost).
# Set 0 only for a plain-HTTP LAN install.
AUTH_COOKIE_SECURE=1
TIME_ZONE=Europe/Paris
